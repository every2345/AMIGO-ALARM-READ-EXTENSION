{
  "manifest_version": 3,
  "name": "Giám Sát Thiết Bị - AEON",
  "version": "1.0",
  "description": "Lấy dữ liệu thiết bị và gửi về Localhost",
  "permissions": [
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:5000/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}